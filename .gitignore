# Environment files
.env

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
storage/logs/*.log
!storage/logs/.gitkeep

# Dependencies
vendor/
node_modules/

# Compiled assets (Sass output)
public/assets/css/*.css.map
# Allow style.css since we're not using Sass compilation in this project
!public/assets/css/style.css
!public/assets/css/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
